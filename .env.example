# Copy to .env (git-ignored) for local dev, and set the same values as repository
# secrets / Actions variables for the production build.

# Beta waitlist endpoint — Buttondown (ADR 0012 Amendment).
# UNSET = no waitlist renders anywhere: no hero form, no closing section, no nav CTA.
# That gate is deliberate. Do not set it until the items under "Waitlist" in
# docs/legal-review-checklist.md are done (DPA accepted, double opt-in on,
# UK transfer leg confirmed) — the Privacy Policy goes live with it.
# PUBLIC_WAITLIST_ENDPOINT="https://buttondown.com/api/emails/embed-subscribe/YOUR-USERNAME"

# Tally questionnaire linked from /waitlist/check-your-inbox and /waitlist/confirmed (ADR 0012).
# The BARE form URL, no query string: SurveyLink.astro appends ?ref=… and, when known, &email=….
# UNSET = /confirmed says the questionnaire will arrive by email; /check-your-inbox omits it.
# PUBLIC_WAITLIST_SURVEY_URL="https://tally.so/r/0Q4pPA"

# Umami website analytics (ADR 0010) — cookieless. Unset = no script is injected.
# PUBLIC_UMAMI_ID=""
