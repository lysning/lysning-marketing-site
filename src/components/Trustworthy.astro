---
const steps = [
  { n: '01', t: 'Refunds come back', d: 'A returned purchase is added back to what you can spend — not left double-counted.' },
  { n: '02', t: 'Transfers cancel out', d: 'Moving money between your own accounts isn’t spending, so it never dents the number.' },
  { n: '03', t: 'Owed-by-others is set apart', d: 'Money a friend will pay back isn’t counted as yours to spend until it lands.' },
];
---
<section id="trustworthy">
  <div class="container">
    <p class="eyebrow">Why the number is trustworthy</p>
    <h2 class="head">A number is only worth believing if the <em class="ever">maths is honest.</em></h2>
    <p class="lead sub">Lysning reconciles the noise most apps leave in your balance, so what you see is real spendable money.</p>
    <div class="grid">
      {steps.map((s) => (
        <div class="step">
          <span class="num tabular">{s.n}</span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .head { max-width: 22ch; }
  .sub { max-width: 58ch; margin-bottom: clamp(40px, 5vw, 64px); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 3.5vw, 44px); }
  .step { padding-top: 20px; border-top: 1px solid var(--rule); }
  .num {
    font-family: var(--font-brand); font-weight: 700; font-size: 0.82rem;
    letter-spacing: 0.06em; color: var(--secondary); display: block; margin-bottom: 14px;
  }
  .step h3 { margin: 0 0 8px; }
  .step p { color: var(--ink-secondary); margin: 0; font-size: 1rem; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; gap: 0; } .step { padding: 22px 0; } }
</style>
