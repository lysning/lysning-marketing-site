---
const items = [
  {
    t: 'Your balance isn’t spendable money',
    d: 'Pending charges, UPI transfers between your own accounts, and refunds all hide inside that one figure. Spend from it and you’re guessing.',
  },
  {
    t: 'Savings leak',
    d: 'The money you meant to save sits right next to the money you meant to spend. Sooner or later, Tuesday’s dinner comes out of the wedding fund.',
  },
  {
    t: 'Reports look backward',
    d: 'A month-end summary tells you what already happened. It can’t answer the question you actually have: can I say yes to this, today?',
  },
];
---
<section id="problem">
  <div class="container">
    <p class="eyebrow">Why saving stalls</p>
    <h2 class="head">Most people aren’t bad at saving.<br />They’re working with the <em class="warm">wrong number.</em></h2>
    <div class="grid">
      {items.map((it, i) => (
        <div class="item">
          <span class="idx tabular">{String(i + 1).padStart(2, '0')}</span>
          <h3>{it.t}</h3>
          <p>{it.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .head { max-width: 20ch; margin-bottom: clamp(44px, 6vw, 72px); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(28px, 4vw, 56px); }
  .item { display: flex; flex-direction: column; }
  .idx {
    font-family: var(--font-display); font-size: 2.6rem; font-weight: 500; font-style: italic;
    color: var(--primary-light); line-height: 1; margin-bottom: 18px; opacity: 0.9;
  }
  .item h3 { margin-bottom: 10px; }
  .item p { color: var(--ink-secondary); margin: 0; font-size: 1rem; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; gap: 36px; } }
</style>
