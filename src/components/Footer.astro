---
import { siBluesky } from 'simple-icons';

const year = new Date().getFullYear();

// Only channels that are actually fed get linked. An empty-but-live account reached from the
// footer of a trust-led site reads abandoned, which is the one impression this pitch can't
// afford. Instagram, r/lysning and X stay registered as name defence and unlinked until each
// has content — see the app repo's GTM doc, "Owned surfaces".
const social = [
  { name: 'Bluesky', href: 'https://bsky.app/profile/lysning.app', icon: siBluesky },
];
---
<footer class="footer">
  <div class="container inner">
    <div class="brand">
      <div class="lockup">
        <img class="mark" src="/mark-3.svg" alt="" width="40" height="40" />
        <span class="wordmark">Lysning</span>
      </div>
      <p class="tag">Free · coming soon in the UK.</p>
      <!-- Who's behind it, without a name (docs/specs/05). The legal pages carry the operator's
           name; nothing here may suggest a team. -->
      <p class="tag">An independent app. Questions reach a person: <a href="mailto:hello@lysning.app">hello@lysning.app</a></p>
    </div>
    <div class="links">
      <a href="/faq">FAQ</a>
      <a href="mailto:hello@lysning.app">hello@lysning.app</a>
      <div class="social">
        {social.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.name} title={s.name}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path d={s.icon.path} />
            </svg>
          </a>
        ))}
      </div>
    </div>
  </div>
  <div class="container legal">
    <span>© {year} Lysning. Your money, kept honest.</span>
    <span class="legal-links">
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
    </span>
  </div>
</footer>

<style>
  /* Evergreen island — see Flexibility.astro */
  .footer {
    --accent-deep: #F0D4B0;
    --ink-inverse: #F0EDE8;
    --focus: var(--ink-inverse);
    background: var(--island); color: var(--ink-inverse); padding-block: 64px 30px;
  }
  .inner { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; flex-wrap: wrap; }
  .lockup { display: flex; align-items: center; gap: 18px; }
  .mark { display: block; width: 40px; height: 40px; }
  .wordmark { font-family: var(--font-wordmark); font-weight: 400; font-size: 1.7rem; letter-spacing: -0.02em; }
  .tag { color: color-mix(in srgb, var(--ink-inverse) 72%, var(--island)); margin: 8px 0 0; font-size: 0.95rem; }
  .tag a { color: var(--accent-deep); }
  .links { display: flex; flex-direction: column; align-items: flex-end; gap: 0; }
  .links > a {
    font-family: var(--font-brand); color: var(--accent-deep); font-weight: 600; font-size: 0.95rem;
    padding-block: 11px;   /* ~22px text -> 44px target */
  }
  .social { display: flex; gap: var(--space-2); flex-wrap: wrap; justify-content: flex-end; }
  .social a {
    display: inline-flex; padding: 13px; border-radius: var(--radius-full);
    color: color-mix(in srgb, var(--ink-inverse) 72%, var(--island));
    transition: color 160ms ease-out, background-color 160ms ease-out;
  }
  .social a:hover { color: var(--accent-deep); background: color-mix(in srgb, var(--ink-inverse) 10%, transparent); }
  .social svg { fill: currentColor; display: block; }
  .legal {
    margin-top: 44px; padding-top: 22px;
    border-top: 1px solid color-mix(in srgb, var(--ink-inverse) 16%, var(--island));
    color: color-mix(in srgb, var(--ink-inverse) 72%, var(--island)); font-size: 0.82rem;
    display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap;
  }
  .legal-links { display: flex; gap: 18px; margin-block: -13px; }
  .legal-links a { color: inherit; font-family: var(--font-brand); padding-block: 13px; }
  .legal-links a:hover { color: var(--accent-deep); }
  @media (prefers-reduced-motion: reduce) { .social a { transition: none; } }
</style>
