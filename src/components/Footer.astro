---
import { siBluesky, siInstagram, siReddit, siX } from 'simple-icons';

const year = new Date().getFullYear();

const social = [
  { name: 'Bluesky', href: 'https://bsky.app/profile/lysning.app', icon: siBluesky },
  { name: 'Instagram', href: 'https://www.instagram.com/lysningapp', icon: siInstagram },
  { name: 'Reddit', href: 'https://www.reddit.com/r/lysning/', icon: siReddit },
  { name: 'X', href: 'https://x.com/lysningapp', icon: siX },
];
---
<footer class="footer">
  <div class="container inner">
    <div class="brand">
      <span class="wordmark">Lysning</span>
      <p class="tag">Free · coming soon in the UK.</p>
    </div>
    <div class="links">
      <a href="/faq">FAQ</a>
      <a href="mailto:hello@lysning.app">hello@lysning.app</a>
      <div class="social">
        {social.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.name} title={s.name}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path d={s.icon.path} />
            </svg>
          </a>
        ))}
      </div>
    </div>
  </div>
  <div class="container legal">
    <span>© {year} Lysning. Your money, kept honest.</span>
    <span class="legal-links">
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
    </span>
  </div>
</footer>

<style>
  .footer { background: var(--primary); color: var(--ink-inverse); padding-block: 64px 30px; }
  .inner { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; flex-wrap: wrap; }
  .wordmark { font-family: var(--font-display); font-weight: 600; font-size: 1.7rem; letter-spacing: -0.02em; }
  .tag { color: color-mix(in srgb, var(--ink-inverse) 72%, var(--primary)); margin: 8px 0 0; font-size: 0.95rem; }
  .links { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
  .links > a { font-family: var(--font-brand); color: var(--accent); font-weight: 600; font-size: 0.95rem; }
  .social { display: flex; gap: 14px; flex-wrap: wrap; justify-content: flex-end; margin-top: 4px; }
  .social a {
    display: inline-flex; padding: 5px; border-radius: 999px;
    color: color-mix(in srgb, var(--ink-inverse) 72%, var(--primary));
    transition: color 160ms ease-out, background-color 160ms ease-out;
  }
  .social a:hover { color: var(--accent); background: color-mix(in srgb, var(--ink-inverse) 10%, transparent); }
  .social svg { fill: currentColor; display: block; }
  .legal {
    margin-top: 44px; padding-top: 22px;
    border-top: 1px solid color-mix(in srgb, var(--ink-inverse) 16%, var(--primary));
    color: color-mix(in srgb, var(--ink-inverse) 58%, var(--primary)); font-size: 0.82rem;
    display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap;
  }
  .legal-links { display: flex; gap: 18px; }
  .legal-links a { color: inherit; font-family: var(--font-brand); }
  .legal-links a:hover { color: var(--accent); }
  @media (prefers-reduced-motion: reduce) { .social a { transition: none; } }
</style>
