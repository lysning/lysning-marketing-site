---
import PhoneFrame from './PhoneFrame.astro';
import calendarShot from '../assets/screens/calendar.png';
import WaitlistForm from './WaitlistForm.astro';
---
<!--
  HERO COPY IS A PLACEHOLDER. ADR 0004 is open — the hero line is not decided.
  The line below follows candidate D (date-led) so the page reads coherently; it has not
  been chosen.

  The visual is no longer open (ADR 0004 §"To decide" item 2). It is the Plan hub, scrolled
  to the goal sections: every goal carries a month and the monthly rate that month is divided
  out of, which is the claim the headline makes. The STS home screen that argued against a
  date-led line is still on the page — it is just further down, where it belongs as proof
  rather than as the pitch.
-->
<section class="hero wash">
  <div class="container grid">
    <div class="copy">
      <p class="eyebrow">Plan forward · UK</p>
      <h1>Not “can I afford it?”<br />but <em class="ever">when.</em></h1>
      <p class="lead">
        Lysning works out what you can genuinely save each month, then gives every goal a date —
        a deposit, a wedding, a car, the cushion that lets you sleep. Change what you set aside
        and the dates move, while the decision is still in front of you.
      </p>
      <WaitlistForm id="hero" />
      <p class="meta"><span class="tick"></span>Free · no account · runs on your phone</p>
    </div>
    <div class="art">
      <div class="halo"></div>
      <PhoneFrame
        label="Lysning affordability calendar"
        src={calendarShot}
        alt="Plan screen: £897 safe to set aside toward a goal, £1,100 a month already committed, above the goals it pays for — Flat deposit, £12,500 of £40,000, on track for Jan 2030 at £700 a month; Emergency fund, on track for Aug 2029 at £250 a month."
      />
    </div>
  </div>
</section>

<style>
  .hero { padding-top: clamp(40px, 7vw, 84px); overflow: hidden; }
  .grid {
    display: grid; grid-template-columns: 1.04fr 0.96fr;
    gap: clamp(32px, 6vw, 80px); align-items: center;
  }
  .copy h1 { margin-bottom: 0.5em; }
  .lead { margin-bottom: 1.8rem; }
  .copy :global(.wl) + .meta { margin-top: 1.6rem; }
  .meta {
    font-family: var(--font-brand); font-weight: 600; font-size: 0.9rem;
    letter-spacing: 0.01em; color: var(--ink-secondary);
    display: inline-flex; align-items: center; gap: 9px; margin: 0;
  }
  .tick { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--accent-muted); }

  .art { position: relative; display: flex; justify-content: center; }
  .halo {
    position: absolute; inset: 8% 16% 4%;
    background: radial-gradient(60% 55% at 50% 42%, color-mix(in srgb, var(--accent) 34%, transparent), transparent 72%);
    filter: blur(30px); z-index: 0;
  }
  .art :global(.phone) { position: relative; z-index: 1; }

  /* No .art { order: -1 } here on purpose: unlike the other sections, the hero's job is
     to lead with the headline, not a captioned mockup. */
  @media (max-width: 820px) {
    .grid { grid-template-columns: 1fr; text-align: left; }
  }
</style>
