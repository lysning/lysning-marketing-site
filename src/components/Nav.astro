---
// The CTA is gated on the same env var as the form itself (ADR 0012) — without it the
// #waitlist section doesn't render, so the button would point at nothing.
const endpoint = import.meta.env.PUBLIC_WAITLIST_ENDPOINT;
---
<nav class="nav" aria-label="Primary">
  <div class="container inner">
    <a href="/" class="wordmark">Lysning</a>
    {endpoint
      ? <a href="#waitlist" class="cta">Join the waitlist</a>
      : <span class="pill">Coming soon · UK</span>}
  </div>
</nav>

<style>
  .nav {
    position: sticky; top: 0; z-index: 10;
    /* Opaque by default. Without backdrop-filter the translucent version leaves page
       content scrolling visibly under the nav text. */
    background: var(--bg);
    border-bottom: 1px solid var(--border-light);
  }
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .nav {
      background: color-mix(in srgb, var(--bg) 82%, transparent);
      -webkit-backdrop-filter: blur(10px) saturate(1.1);
      backdrop-filter: blur(10px) saturate(1.1);
    }
  }
  .inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); height: var(--nav-h); }
  .wordmark {
    font-family: var(--font-display); font-weight: 600; font-size: 1.5rem;
    letter-spacing: -0.02em; color: var(--primary-text); text-decoration: none;
  }
  .wordmark:hover { text-decoration: none; }

  .cta {
    display: inline-flex; align-items: center;
    min-height: 44px; padding: 0 var(--space-5);
    font-family: var(--font-brand); font-size: 0.9rem; font-weight: 600;
    color: var(--ink-inverse); background: var(--primary);
    border-radius: var(--radius-full); text-decoration: none;
    white-space: nowrap;
    transition: background-color 160ms ease-out;
  }
  .cta:hover { background: var(--primary-hover); text-decoration: none; }
  .cta:active { background: var(--primary-pressed); }
  @media (prefers-reduced-motion: reduce) { .cta { transition: none; } }
</style>
