---
const rows = [
  { label: 'Balance across accounts', val: '₹48,200', tone: 'ink' },
  { label: 'Pending & transfers netted out', val: '− ₹6,800', tone: 'muted' },
  { label: 'Earmarked for your goals', val: '− ₹32,000', tone: 'accent' },
  { label: 'Fixed costs still due this month', val: '− ₹7,000', tone: 'muted' },
];
---
<section id="safe-to-spend" class="sts-sec">
  <div class="container grid">
    <div class="copy">
      <p class="eyebrow">Safe-to-Spend</p>
      <h2>One honest number that answers a real question: <em class="ever">“Can I say yes to this today?”</em></h2>
      <p class="lead">
        Orielle starts from your real money, clears out the noise, and sets aside what your goals
        have claimed. What’s left is genuinely free, and what you do with it is your call. Spend it
        on dinner or let it ride. Your goals are already covered either way.
      </p>
    </div>

    <figure class="calc surface-data">
      <figcaption class="calc-cap">Today’s reconciliation</figcaption>
      {rows.map((r) => (
        <div class="ledger-row">
          <span class="rl">{r.label}</span>
          <span class={`rv tabular ${r.tone}`}>{r.val}</span>
        </div>
      ))}
      <div class="total">
        <span class="tl">Safe to spend today</span>
        <span class="tv tabular">₹2,400</span>
      </div>
    </figure>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 72px); align-items: center; }

  .calc { padding: clamp(18px, 2.4vw, 26px) clamp(20px, 2.6vw, 30px) clamp(20px, 2.6vw, 28px); margin: 0; }
  .calc-cap {
    font-family: var(--font-brand); font-size: 0.72rem; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-muted);
    padding-bottom: 12px; margin-bottom: 4px; border-bottom: 1px solid var(--rule);
  }
  .rl { color: var(--ink-secondary); font-size: 0.98rem; }
  .rv { font-family: var(--font-brand); font-weight: 600; letter-spacing: -0.01em; white-space: nowrap; }
  .rv.ink { color: var(--ink); }
  .rv.muted { color: var(--ink-muted); }
  .rv.accent { color: var(--accent-hover); }

  .total {
    display: flex; align-items: baseline; justify-content: space-between; gap: 16px;
    margin-top: 20px; padding-top: 20px; border-top: 2px solid var(--primary);
  }
  .tl { font-family: var(--font-brand); font-weight: 600; font-size: 1rem; color: var(--primary); }
  .tv {
    font-family: var(--font-brand); font-weight: 700; color: var(--primary);
    font-size: clamp(2.4rem, 5vw, 3.4rem); letter-spacing: -0.03em; line-height: 1;
  }

  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } }
</style>
