---
import PhoneFrame from './PhoneFrame.astro';
import privacyShot from '../assets/screens/privacy.png';
const badges = ['On-device today', 'No account needed', 'Never sold', 'Yours to export'];
---
<!--
  The only section whose claims the reader cannot check anywhere else on the page, so it
  carries the screen that makes them: the app's own first-run gate, where analytics is off
  until it is switched on and "Don't allow" is a real button. The same words in the app and
  on the page is the point — a privacy claim a site makes about itself is worth less than
  the one the product puts in front of a new user.
-->
<section id="privacy" class="privacy">
  <div class="container grid">
    <div class="inner">
      <p class="eyebrow">Your data, your control</p>
      <h2>Your financial life is yours. <em class="ever">We treat it that way.</em></h2>
      <p class="lead">
        Today, Lysning runs entirely on your phone. There’s no account to create and no server copy
        of your finances. If a future feature ever needs to store data, like sync or backup, it will
        be yours to switch on, protected by the privacy laws that apply to you, including UK GDPR
        and the Data Protection Act 2018. And we will never sell your data. That part isn’t a feature. It’s the
        business model.
      </p>
      <p class="downside">
        <strong>The honest flip side:</strong> if you lose the phone or delete the app, the data
        goes with it. There’s no cloud copy to restore from — that’s the trade for there being no
        server. Export and encrypted backup are there for exactly this reason.
      </p>
      <div class="badges">
        {badges.map((b) => <span class="badge">{b}</span>)}
      </div>
    </div>
    <div class="art">
      <PhoneFrame
        label="Lysning first-run privacy screen"
        src={privacyShot}
        alt="First-run screen, 'Your money stays on this device': Lysning runs entirely on your phone, no account, no servers; usage data and crash reports are optional and off unless turned on; no financial data ever leaves the device. Buttons: Allow usage analytics, Don't allow."
      />
    </div>
  </div>
</section>

<style>
  .downside {
    margin: 1.4rem 0 0; max-width: var(--measure); font-size: 0.98rem;
    color: var(--ink-secondary); padding-top: 16px; border-top: 1px solid var(--rule);
  }
  .downside strong { color: var(--ink); font-weight: 600; }

  .privacy { background: var(--secondary-subtle); }
  .grid {
    display: grid; grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 6vw, 76px); align-items: center;
  }
  .art { display: flex; justify-content: center; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } }
  .inner { max-width: 66ch; }
  .privacy h2 { max-width: 20ch; }
  .badges { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .badge {
    font-family: var(--font-brand); font-weight: 600; font-size: 0.84rem;
    color: var(--primary-text); background: var(--surface);
    border: 1px solid var(--primary-muted); border-radius: var(--radius-full);
    padding: 8px 16px 8px 30px; position: relative;
  }
  /* 0.84rem on --surface: --primary-text lands at 4.23 in dark, so use ink there */
  @media (prefers-color-scheme: dark) { .badge { color: var(--ink); } }
  .badge::before {
    content: ''; position: absolute; left: 13px; top: 50%;
    width: 6px; height: 10px; margin-top: -6px;
    border: solid var(--secondary); border-width: 0 2px 2px 0; transform: rotate(45deg);
  }
</style>
