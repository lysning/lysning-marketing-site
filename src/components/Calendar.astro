---
// The wedge (site-spec §"What the site is actually selling"). Data surface, not a phone
// mock — the hero already carries the affordability screen. Dates UK format, no red,
// no percentages-as-grades, gap expressed as a choice rather than a verdict.
//
// These are the app's own figures, not illustrative ones. They come from the
// marketing fixture the screenshots are captured against (`src/db/marketingSeed.ts`
// in lysning-app), so the goals, the rate, and every month below are the same ones
// a reader sees in the phone beside them. They were invented before the screenshots
// existed and disagreed with them on every line — a deposit of £28,000 arriving in
// 2029 next to a screenshot of £40,000 arriving in 2030 — which is the one thing a
// page whose entire argument is "the date is real" cannot afford.
//
// `then` is the same arithmetic the app does: the remainder over the new monthly
// rate, rounded up to whole months. Only the deposit's rate is raised, so only the
// deposit moves — one date moving is what actually happens, and the earlier copy's
// two were the tell that nobody had run the numbers.
const goals = [
  { name: 'Japan, next spring', target: '£1,950',  now: 'Jun 2027', then: 'Jun 2027', moved: false },
  { name: 'Emergency fund',     target: '£12,000', now: 'Sep 2029', then: 'Sep 2029', moved: false },
  { name: 'Flat deposit',       target: '£40,000', now: 'Feb 2030', then: 'May 2029', moved: true },
];
---
<section id="calendar" class="cal-sec">
  <div class="container grid">
    <div class="copy">
      <p class="eyebrow">The affordability calendar</p>
      <h2>Every goal gets a <em class="ever">date</em>. Change what you save, and the dates move.</h2>
      <p class="lead">
        Lysning turns what you can genuinely set aside into the month each goal becomes affordable.
      </p>
    </div>

    <figure class="cal surface-data">
      <figcaption class="cal-cap">Affordable from</figcaption>
      <div class="rate">
        <span class="rate-l">Setting aside</span>
        <span class="rate-v tabular">£1,100 <span class="per">a month</span></span>
      </div>
      <ul class="list">
        {goals.map((g) => (
          <li class="row">
            <span class="g-name">{g.name}</span>
            <span class="g-target tabular">{g.target}</span>
            <span class="g-date tabular">{g.now}</span>
          </li>
        ))}
      </ul>

      <div class="delta">
        <p class="delta-q">Set aside <span class="tabular">£1,300</span> instead?</p>
        <ul class="list">
          {goals.map((g) => (
            <li class="row">
              <span class="g-name">{g.name}</span>
              <span class={g.moved ? 'g-date tabular moved' : 'g-date tabular same'}>
                {g.then}{g.moved ? '' : ' · unchanged'}
              </span>
            </li>
          ))}
        </ul>
      </div>
      <p class="cal-foot">Nothing is committed until you choose.</p>
    </figure>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(32px, 6vw, 72px); align-items: center; }

  .cal { padding: clamp(18px, 2.4vw, 26px) clamp(20px, 2.6vw, 30px) clamp(18px, 2.4vw, 24px); margin: 0; }
  .cal-cap {
    font-family: var(--font-brand); font-size: 0.72rem; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-muted);
    padding-bottom: 12px; border-bottom: 1px solid var(--rule);
  }
  .rate { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 14px 0 10px; }
  .rate-l { color: var(--ink-secondary); font-size: 0.95rem; }
  .rate-v { font-family: var(--font-brand); font-weight: 700; font-size: 1.3rem; color: var(--primary-text); letter-spacing: -0.02em; }
  .per { font-weight: 600; font-size: 0.75rem; color: var(--ink-muted); letter-spacing: 0; }

  .list { list-style: none; margin: 0; padding: 0; }
  .row {
    display: grid; grid-template-columns: 1fr auto; gap: 2px 14px; align-items: baseline;
    padding: 9px 0; border-top: 1px solid var(--border-light);
  }
  .g-name { font-family: var(--font-brand); font-weight: 600; font-size: 0.95rem; color: var(--ink); }
  .g-target { grid-column: 1; font-size: 0.78rem; color: var(--ink-muted); }
  .g-date { font-family: var(--font-brand); font-weight: 600; font-size: 0.95rem; color: var(--ink-secondary); white-space: nowrap; text-align: right; }
  .g-date.moved { color: var(--accent-deep); }
  .g-date.same { color: var(--ink-muted); font-weight: 500; }

  .delta { margin-top: 18px; padding-top: 16px; border-top: 2px solid var(--primary-text); }
  .delta-q { font-family: var(--font-brand); font-weight: 600; font-size: 1rem; color: var(--primary-text); margin: 0 0 6px; }
  @media (prefers-color-scheme: dark) { .delta-q { color: var(--ink); } }
  .delta .row:first-child { border-top: 0; }
  .cal-foot { font-size: 0.8rem; color: var(--ink-muted); margin: 14px 0 0; }

  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } }
</style>
