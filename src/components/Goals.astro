---
import PhoneFrame from './PhoneFrame.astro';
import goalShot from '../assets/screens/goal.png';
---
<section id="goals" class="goals">
  <div class="container grid">
    <div class="art">
      <PhoneFrame
        label="Lysning goal screen"
        src={goalShot}
        alt="Flat deposit goal: £12,500 of £40,000 reserved, £700 set aside this month, on track for Jan 2030."
      />
    </div>
    <div class="copy">
      <p class="eyebrow">Why the date is real</p>
      <h2>A date you can trust needs money that’s <em class="warm">actually there.</em></h2>
      <p class="lead">
        Most apps track a goal as a number that goes up. Lysning earmarks the money in your own
        account, so the same pound is never promised to two things at once. That’s the difference
        between a projection and a plan: the date holds because the money behind it isn’t quietly
        available for something else.
      </p>
      <p class="note">
        <strong>Lysning never holds, moves, or invests your money.</strong> Nothing changes hands,
        and nothing leaves your bank. Unlike apps that take custody of your savings, everything
        stays exactly where it is — Lysning just keeps the accounting honest.
      </p>
    </div>
  </div>
</section>

<style>
  .goals { background: var(--surface-alt); }
  .grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(32px, 6vw, 76px); align-items: center; }
  .art { display: flex; justify-content: center; }
  .note {
    position: relative; margin-top: 1.6rem; padding: 16px 20px 16px 22px;
    color: var(--ink-secondary); font-size: 0.98rem; max-width: var(--measure);
    background: var(--secondary-subtle); border-radius: var(--radius-mood);
  }
  .note::before {
    content: ''; position: absolute; left: 0; top: 14px; bottom: 14px; width: 3px;
    border-radius: var(--radius-full); background: var(--secondary);
  }
  .note strong { color: var(--ink); font-weight: 600; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } .art { order: -1; } }
</style>
