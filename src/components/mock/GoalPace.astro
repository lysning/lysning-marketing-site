---
// Placeholder goal pace-marker mockup — earmarked goal, saved money always amber,
// gap expressed as options, never "behind = red" (design-guidelines §5.2).
---
<div class="pace">
  <header class="bar">
    <span class="back">‹</span>
    <span class="title">Wedding fund</span>
    <span></span>
  </header>

  <p class="target">Target £30,000 by May 2027</p>

  <div class="track">
    <div class="fill" style="width:62%"></div>
    <div class="marker" style="left:66%"></div>
  </div>
  <p class="marker-label">even pace today ▲</p>

  <p class="saved tabular">£18,600 saved · <span class="ahead">£600 ahead of pace</span></p>
  <p class="proj">At this pace, you’ll hit the goal by March 2027.</p>

  <div class="paths">
    <span class="path">Keep current plan</span>
    <span class="path">Reduce monthly</span>
    <span class="path">Allocate surplus</span>
  </div>

  <div class="earmark">
    <span>Earmarked in Monzo ····</span>
    <span class="lock">your money, untouched</span>
  </div>
</div>

<style>
  .pace { flex: 1; padding: 34px 20px 20px; display: flex; flex-direction: column; gap: 12px; }
  .bar { display: flex; align-items: center; justify-content: space-between; }
  .back { color: var(--ink-muted); font-size: 1.3rem; line-height: 1; }
  .title { font-family: var(--font-brand); font-weight: 600; font-size: 0.95rem; }

  .target { font-size: 0.8rem; color: var(--ink-muted); margin: 4px 0 8px; }

  .track { position: relative; height: 10px; background: var(--surface-sunken); border-radius: var(--radius-full); }
  .fill { position: absolute; inset: 0 auto 0 0; background: var(--accent); border-radius: var(--radius-full); }
  .marker { position: absolute; top: -3px; bottom: -3px; width: 2px; background: var(--ink-muted); }
  .marker-label { font-size: 0.68rem; color: var(--ink-muted); margin: 2px 0 6px; }

  .saved { font-family: var(--font-brand); font-weight: 600; font-size: 0.95rem; margin: 0; }
  .ahead { color: var(--accent-hover); }
  .proj { font-size: 0.8rem; color: var(--ink-secondary); margin: 0; }

  .paths { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
  .path { font-size: 0.72rem; font-weight: 600; color: var(--primary); background: var(--primary-subtle); border-radius: var(--radius-full); padding: 6px 10px; }

  .earmark {
    margin-top: auto; display: flex; justify-content: space-between; align-items: center;
    font-size: 0.72rem; color: var(--ink-muted);
    background: var(--surface-alt); border: 1px solid var(--border-light);
    border-radius: var(--radius-md); padding: 10px 12px;
  }
  .lock { color: var(--secondary); font-weight: 600; }
</style>
