---
// Reusable iOS-style device frame. Pass `src` for a real app screenshot (src/assets/screens,
// copied from lysning-app/out/screenshots/raw). Without `src` the <slot/> renders a
// PLACEHOLDER mock (ADR 0007) — no section does this any more; every device on the page is a
// real capture. The slot is kept for the next screen that has to be drawn before it is built.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
// `priority` is for the one device above the fold (the hero): loaded eagerly and first, since
// it is the page's largest paint. Every other frame stays lazy.
interface Props { label?: string; dark?: boolean; src?: ImageMetadata; alt?: string; priority?: boolean; }
const { label, dark = false, src, alt = '', priority = false } = Astro.props;
---
<figure class="phone" aria-label={label ?? (src ? 'Lysning app screen' : 'Lysning app screen (mockup)')}>
  <div class="bezel">
    <div class:list={['screen', { dark, 'palette-light': !dark && !src }]}>
      {src && <span class="island" aria-hidden="true"></span>}
      {src
        ? <Image src={src} alt={alt} width={900} widths={[300, 600, 900]} sizes="300px" class="shot"
            loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} />
        : <slot />}
    </div>
  </div>
  {!src && <figcaption>Mockup — final build uses real app screenshots</figcaption>}
</figure>

<style>
  .phone { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  /* A thin black bezel inside a sage rim. The black alone sank into the dark page's ground
     and the phone lost its edge; the rim keeps it in both palettes (--secondary lifts on dark). */
  .bezel {
    width: 300px;
    max-width: 78vw;
    border-radius: 50px;
    background: #14100c;
    padding: 6px;
    box-shadow: 0 0 0 4px var(--secondary), var(--shadow-lg);
  }
  .screen {
    position: relative;
    border-radius: 44px;
    overflow: hidden;
    background: var(--bg);
    aspect-ratio: 1206 / 2622;
    display: flex;
    flex-direction: column;
  }
  .screen.dark { background: #081410; }
  /* The Dynamic Island, at iPhone 17 Pro proportions: 125 × 37pt, 11pt down, on a 402 × 874pt
     screen. Vertical values are fractions of the height and horizontal of the width, so it
     scales with the frame. It sits between the clock and the status icons, covering neither. */
  .island {
    position: absolute; z-index: 1; left: 50%; transform: translateX(-50%);
    top: 1.26%; width: 31.1%; height: 4.23%;
    border-radius: var(--radius-full); background: #000;
  }
  .shot { display: block; width: 100%; height: 100%; object-fit: cover; }
  figcaption { font-size: 0.72rem; color: var(--ink-muted); }
</style>
