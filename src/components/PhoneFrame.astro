---
// Reusable iOS-style device frame. Pass `src` for a real app screenshot (src/assets/screens,
// copied from lysning-app/out/screenshots/raw). Without `src` the <slot/> renders a
// PLACEHOLDER mock (ADR 0007) — no section does this any more; every device on the page is a
// real capture. The slot is kept for the next screen that has to be drawn before it is built.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { label?: string; dark?: boolean; src?: ImageMetadata; alt?: string; }
const { label, dark = false, src, alt = '' } = Astro.props;
---
<figure class="phone" aria-label={label ?? (src ? 'Lysning app screen' : 'Lysning app screen (mockup)')}>
  <div class="bezel">
    <div class:list={['screen', { dark, 'palette-light': !dark && !src }]}>
      {src
        ? <Image src={src} alt={alt} widths={[300, 600, 900]} sizes="300px" class="shot" />
        : <slot />}
    </div>
  </div>
  {!src && <figcaption>Mockup — final build uses real app screenshots</figcaption>}
</figure>

<style>
  .phone { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .bezel {
    width: 300px;
    max-width: 78vw;
    border-radius: 50px;
    background: #14100c;
    padding: 11px;
    box-shadow: var(--shadow-lg);
  }
  .screen {
    position: relative;
    border-radius: 40px;
    overflow: hidden;
    background: var(--bg);
    aspect-ratio: 1206 / 2622;
    display: flex;
    flex-direction: column;
  }
  .screen.dark { background: #081410; }
  .shot { display: block; width: 100%; height: 100%; object-fit: cover; }
  figcaption { font-size: 0.72rem; color: var(--ink-muted); }
</style>
