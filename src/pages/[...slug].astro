---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true
  );
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
// Cards exist for the published pages; anything else falls back to the home card.
// Privacy and Terms are not here: they have their own routes, because each is a
// dated revision in the `legal` collection rather than a single page.
const ogImage = page.id === 'faq' ? `/og/${page.id}.png` : '/og/home.png';
---
<Base title={page.data.title} description={page.data.description} ogImage={ogImage}>
  <Nav />
  <main id="main" tabindex="-1">
    <section class="page">
      <div class="container">
        {page.data.kicker && <p class="eyebrow">{page.data.kicker}</p>}
        <h1>{page.data.title}</h1>
        <div class="doc">
          <Content />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .page { padding-block: var(--section-gap); }
  h1 { max-width: 20ch; margin-bottom: clamp(44px, 6vw, 72px); text-wrap: balance; }
  .doc :global(h2) {
    font-size: 1.4rem;
    font-weight: 600;
    max-width: var(--measure);
    text-wrap: balance;
    padding-top: var(--space-8);
    margin-top: var(--space-8);
    border-top: 1px solid var(--rule);
  }
  .doc :global(h2:first-of-type) {
    padding-top: 0;
    margin-top: 0;
    border-top: 0;
  }
  .doc :global(h3) {
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.35;
    max-width: var(--measure);
    text-wrap: pretty;
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }
  .doc :global(h3 + p) { margin-top: 0; }
  .doc :global(p) {
    color: var(--ink-secondary);
    max-width: var(--measure);
  }
  .doc :global(li) {
    color: var(--ink-secondary);
    max-width: var(--measure);
    margin-bottom: var(--space-2);
  }
</style>
