---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true
  );
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.description}>
  <Nav />
  <main>
    <section class="page">
      <div class="container">
        <p class="eyebrow">{page.data.title}</p>
        <h1>{page.data.title}</h1>
        <div class="doc">
          <Content />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .page { padding-block: var(--section-gap); }
  h1 { max-width: 20ch; margin-bottom: clamp(44px, 6vw, 72px); }
  .doc :global(h2) {
    font-size: 1.4rem;
    font-weight: 600;
    padding-top: var(--space-8);
    margin-top: var(--space-8);
    border-top: 1px solid var(--rule);
  }
  .doc :global(h2:first-of-type) {
    padding-top: 0;
    margin-top: 0;
    border-top: 0;
  }
  .doc :global(p) {
    color: var(--ink-secondary);
    max-width: var(--measure);
  }
</style>
